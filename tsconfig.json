{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["node", "vscode"],
    "paths": {
      "@battledragon/visualiser": ["./vendor/unswbc/packages/visualiser/src/index.ts"],
      "capnp-es": ["./node_modules/capnp-es"]
    }
  },
  "include": ["src/**/*.ts", "webview/**/*.ts", "webview/**/*.svelte", "webview/**/*.d.ts", "tests/**/*.ts"]
}
